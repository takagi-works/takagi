module Takagi
  # Coordinates local topics and remote observe subscriptions.
  class Reactor
    @topics: untyped

    @observers: untyped

    def initialize: () -> void

    def topic: (untyped path) { (?) -> untyped } -> Topic

    def observe: (untyped uri) { (?) -> untyped } -> untyped

    def trigger_observe: (untyped uri, untyped value) -> untyped

    def start: () -> untyped
  end
end
