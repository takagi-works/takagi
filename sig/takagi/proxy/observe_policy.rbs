module Takagi
  class Proxy::ObservePolicy
    OBSERVE: Integer

    def initialize: (?logger: untyped) -> void

    # Whether the request asks to observe.
    def observing?: (Takagi::Message::Inbound request) -> bool

    # The options the outbound request carries: Observe is dropped, so no observation is opened.
    def forwarded_options: (
      Takagi::Message::Inbound request,
      Hash[Integer, untyped] options
    ) -> Hash[Integer, untyped]

    # The options the client's response carries: Observe is never handed back.
    def reply_options: (Hash[Integer, untyped]? options) -> Hash[Integer, untyped]
  end
end
