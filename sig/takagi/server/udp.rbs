module Takagi
  module Server
    # UDP server for handling CoAP messages
    class Udp
      @port: untyped

      @worker_processes: untyped

      @worker_threads: untyped

      @middleware_stack: untyped

      @router: untyped

      @logger: untyped

      @watcher: untyped

      @socket: untyped

      @sender: untyped

      @shutdown_called: untyped

      @cluster: untyped

      @owned_cluster: untyped

      @adapter: untyped

      DRAIN_DEADLINE: ::Float

      attr_reader cluster: untyped

      attr_reader adapter: untyped

      def bound_port: () -> ::Integer

      def supervised_by: (untyped cluster) -> untyped

      def start_service_hooks!: () -> untyped

      def worker_pids: () -> untyped

      def initialize: (?port: ::Integer, ?worker_processes: ::Integer, ?worker_threads: ::Integer, ?middleware_stack: untyped?, ?router: untyped?, ?logger: untyped?, ?watcher: untyped?) -> void

      # Starts the server with multiple worker processes
      def run!: () -> untyped

      # Gracefully shuts down all workers
      def shutdown!: () -> (nil | untyped)

      private

      def log_boot_details: () -> untyped

      def stop_requested?: () -> untyped

      def request_stop!: () -> untyped

      def prepare_serving_process: () -> void

      def serve_datagrams: () -> untyped

      def build_worker: () -> untyped

      def worker_configuration: () -> { port: untyped, socket: untyped, middleware_stack: untyped, router: untyped, sender: untyped, logger: untyped, threads: untyped }

      def close_socket: () -> untyped
    end
  end
end
