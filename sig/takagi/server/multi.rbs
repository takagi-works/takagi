module Takagi
  module Server
    # Runs a service's transports concurrently through ONE cluster
    class Multi
      @servers: untyped

      @protocols: untyped

      @logger: untyped

      @adapters: untyped

      @ports: untyped

      @cluster: untyped

      @server_thread: untyped

      attr_reader servers: untyped

      attr_reader cluster: untyped

      def initialize: (untyped servers, ?protocols: untyped?, ?logger: untyped?) -> void

      def worker_pids: () -> untyped

      def run!: () -> untyped

      def shutdown!: () -> untyped
    end
  end
end
