module Takagi
  module Observer
    # Lightweight CoAP observe client for integration testing.
    class Client
      @uri: untyped

      @token: untyped

      @socket: untyped

      @on_notify: untyped

      @running: untyped

      @thread: untyped

      def initialize: (untyped uri) -> void

      def on_notify: () { (?) -> untyped } -> untyped

      def on_subscription_failed: () { (?) -> untyped } -> untyped

      def subscribe: () -> (:subscribed | :failed)

      def cancel: () -> void

      def stop: () -> untyped

      def token: () -> untyped

      def last_seq: () -> (Integer | nil)

      alias close stop

      private

      def send_observe_request: () -> untyped

      def listen_for_notifications: () -> untyped

      def handle_notification_iteration: () -> untyped
    end
  end
end
