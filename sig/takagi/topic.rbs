module Takagi
  class Topic
    DEFAULT_CONTENT_FORMAT: Integer

    def initialize: (String path, ?content_format: Integer) { (Takagi::Observable::Emitter) -> untyped } -> void

    attr_reader path: String
    attr_reader content_format: Integer

    def current_value: () -> untyped
    def sequence: () -> Integer
    def emitter: () -> Takagi::Observable::Emitter
    def deleted?: () -> bool
    def publish: (untyped new_value) -> bool
    def delete: () -> void
    def handle_request: (Takagi::Message::Inbound request) -> Takagi::Message::Outbound
  end
end