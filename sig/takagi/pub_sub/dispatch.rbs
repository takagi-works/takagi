module Takagi
  module PubSub
    module Dispatch
      class UnsupportedCapabilityError < StandardError
      end

      class UnsupportedVerbError < StandardError
      end

      PATTERN_OPTIONS: Array[Symbol]

      def self.dispatch: (Symbol | String transport_name, Symbol | String verb, ?options: Hash[untyped, untyped]) -> untyped
      def self.validate!: (Symbol | String transport_name, untyped transport, Symbol verb, ?options: Hash[untyped, untyped]) -> void
    end
  end
end