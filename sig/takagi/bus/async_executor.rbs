module Takagi
  class Bus
    module AsyncExecutor
      # Thread-based executor (default fallback)
      class ThreadExecutor
        DEFAULT_BACKLOG_LIMIT: ::Integer

        @size: untyped

        @queue: untyped

        @threads: untyped

        @shutdown: untyped

        attr_reader size: untyped

        attr_reader backlog_limit: untyped

        def initialize: (size: untyped, ?backlog_limit: untyped) -> void

        # Queue one message for one subscriber.
        #
        # @return [Boolean] false when that subscriber's backlog is full and the message was refused
        def post: (untyped handler, untyped message) -> bool

        def register_handler: (untyped _handler) -> nil

        def unregister_handler: (untyped _handler) -> nil

        def shutdown: () -> (nil | untyped)

        def running?: () -> untyped

        def stats: () -> ::Hash[::Symbol, untyped]

        private

        def start_workers: () -> untyped

        def worker_loop: () -> untyped

        # Hand the first message of a burst to a worker; every later one joins the backlog.
        def promote: (untyped handler) -> untyped

        # Run one subscriber's backlog to exhaustion before releasing its in-flight slot.
        def drain: (untyped handler) -> untyped

        def deliver: (untyped handler, untyped message) -> untyped

        def log_refusal: (untyped handler) -> untyped
      end
    end
  end
end
